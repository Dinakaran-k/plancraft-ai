{
  "name": "plancraft-ai",
  "version": "1.0.0",
  "description": "PlanCraft AI — GenAI-Powered Planning Assistant for Weddings, Birthdays, and Community Events",
  "main": "server/app.js",
  "scripts": {
    "install:all": "npm install --include=dev && npm install --prefix server && npm install --prefix client --include=dev",
    "dev:server": "npm run dev --prefix server",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:client": "npm run build --prefix client",
    "test:server": "npm run test --prefix server",
    "test:client": "npm run test --prefix client",
    "test": "npm run test:server && npm run test:client",
    "lint": "eslint client/src server",
    "lint:fix": "eslint --fix client/src server",
    "format:check": "prettier --check \"client/src/**/*.{js,jsx}\" \"server/**/*.js\"",
    "format": "prettier --write \"client/src/**/*.{js,jsx}\" \"server/**/*.js\"",
    "build": "npm run install:all && npm run build:client",
    "start": "npm run start --prefix server"
  },
  "keywords": [
    "genai",
    "gemini",
    "event-planning",
    "weddings",
    "birthdays",
    "community-events",
    "budgets",
    "timelines",
    "vendors"
  ],
  "author": "Dinakaran Kommunuri",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "eslint": "^9.14.0",
    "eslint-plugin-react": "^7.37.5",
    "prettier": "^3.3.3"
  },
  "dependencies": {
    "@neon/config": "^1.9.5",
    "@neon/env": "^1.6.6"
  }
}
